html { scrollbar-gutter: stable; }
body { font-family: Arial, Helvetica, sans-serif; }
.site-page { display: flex; flex-direction: column; margin: 0; min-height: 100vh; color: #292d34; background: #fff; font-size: 16px; line-height: 1.7; }
.site-page > main { flex: 1; }
.site-page * { box-sizing: border-box; }
.site-page a { color: #805000; text-underline-offset: 3px; }
.site-page a:hover { text-decoration-thickness: 2px; }
.site-page :focus-visible { outline: 3px solid #b76b00; outline-offset: 5px; }
.site-page [id] { scroll-margin-top: 96px; }
.page-container { width: calc(100% - 48px); max-width: 1120px; margin: 0 auto; }
.skip-link { position: absolute; top: -80px; left: 16px; z-index: 20; padding: 10px 16px; background: #fff; }
.skip-link:focus { top: 12px; }
.site-nav { position: sticky; top: 0; z-index: 10; border-bottom: 1px solid #e9e5df; background: #fffffff2; backdrop-filter: blur(12px); }
.nav-inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 72px; }
.site-page .site-brand { display: inline-flex; align-items: center; gap: 10px; color: #252b34; font-size: 24px; font-weight: 800; letter-spacing: -.04em; text-decoration: none; white-space: nowrap; }
.site-brand img { width: 36px; height: 36px; }
.nav-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 24px; }
.nav-links a { color: #41454d; font-size: 12px; font-weight: 700; letter-spacing: .06em; text-decoration: none; text-transform: uppercase; }
.site-page h1 { margin: 0; color: #222833; font-size: 48px; letter-spacing: -.04em; line-height: 1.15; }
.hero { padding: 48px 0 24px; color: #fff; background: linear-gradient(#111b2bb3, #111b2b73), url("/img/header-bg.jpg") center center / cover no-repeat; text-align: center; }
.hero-copy { max-width: 900px; margin: 0 auto; }
.hero h1 { color: #fff; font-size: 68px; line-height: 1.06; text-shadow: 0 2px 20px #111b2b55; }
.hero-description { max-width: 690px; margin: 20px auto; font-size: 20px; line-height: 1.65; text-wrap: pretty; }
.hero-actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 16px 24px; }
.hero .hero-link { color: #fff; font-size: 14px; }
.trial-note { margin: 14px 0 0; color: #fff; font-size: 13px; }
.site-page .install-button { display: inline-flex; align-items: center; justify-content: center; max-width: 100%; min-height: 44px; padding: 10px 22px; border-radius: 6px; color: #24201a; background: #ffb12b; font-size: 16px; font-weight: 700; line-height: 1.4; text-decoration: none; transition: transform .1s ease-in-out, background-color .1s ease-in-out; }
.site-page .install-button:hover { background: #ffc65d; transform: scale(1.03); }
.hero-preview { max-width: 960px; margin: 32px auto 0; }
.hero-preview img { display: block; width: 100%; height: auto; }
.team-count { min-height: 3em; margin: 12px auto 0; max-width: 740px; color: #fff; font-size: 13px; line-height: 1.6; }
.feature-copy h2, .pricing-section h2 { margin: 0 0 16px; color: #222833; font-size: 36px; line-height: 1.2; letter-spacing: -.025em; }
.feature-section { padding: 36px 0; border-top: 1px solid #ede9e2; }
.feature-section:nth-of-type(even) { background: #fcfbf8; }
.feature-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: 72px; }
.feature-copy p { margin: 0 0 16px; font-size: 18px; }
.feature-copy p:last-child { margin-bottom: 0; }
.feature-preview { min-width: 0; margin: 0; padding: 20px; border: 1px solid #e9e5df; border-radius: 12px; background: #fff; box-shadow: 0 12px 40px #242d3910; }
.feature-preview img { display: block; max-width: 100%; height: auto; margin: 0 auto; }
.feature-preview figcaption { margin-top: 12px; color: #62666e; font-size: 13px; text-align: center; }
.pricing-section { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 64px; margin-top: 28px; margin-bottom: 44px; padding: 32px; border: 1px solid #eadfc8; border-radius: 16px; background: #fff7e8; }
.pricing-section p { margin: 0 0 12px; }
.pricing-action { min-width: 210px; text-align: center; }
.section-label { color: #805000; font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
.pricing-section .price { display: flex; flex-direction: column; margin: 0 0 20px; }
.price strong { color: #222833; font-size: 48px; line-height: 1.2; letter-spacing: -.04em; }
.price span { margin-top: 8px; color: #62666e; font-size: 14px; }
.project-info { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 64px; padding-bottom: 36px; text-align: center; }
.project-info h2, .project-info h3 { margin: 0 0 12px; font-size: 18px; }
.project-info p { margin: 0; color: #62666e; font-size: 14px; }
code { padding: 2px 5px; border-radius: 3px; background: #f4f2ee; font-size: .92em; overflow-wrap: anywhere; }
.site-footer { padding: 20px 0; border-top: 1px solid #e9e5df; color: #62666e; font-size: 13px; text-align: center; overflow-wrap: anywhere; }
.site-footer p { margin: 6px 0; }
.site-footer .up { color: #23683a; }
.site-footer .down, .has-error { color: #9b2020; }
.content-page { max-width: 860px; padding: 40px 0; overflow-wrap: anywhere; }
.content-page h1 { margin-bottom: 28px; }
.content-page h3, .content-page h4 { margin-top: 28px; line-height: 1.4; }
.help-header { padding: 40px 0 12px; }
.help-content { max-width: 860px; padding-bottom: 40px; }
.help-section { margin: 28px 0; }
.help-section h2 { font-size: 24px; }
.getting-started-steps { padding-left: 24px; }
.getting-started-steps li { margin: 14px 0; padding-left: 6px; }
.help-topic { padding: 16px 0; border-bottom: 1px solid #e9e5df; }
.help-topic summary { cursor: pointer; font-weight: 700; }
.help-topic img { display: block; max-width: 100%; height: auto; margin: 20px auto; }
.command-topic pre { padding: 16px; border-radius: 6px; background: #f8f6f2; font-size: 14px; line-height: 1.6; white-space: pre-wrap; overflow-wrap: anywhere; }
.command-topic pre code { padding: 0; background: none; font-size: inherit; }
.registration-panel { max-width: 760px; padding: 60px 0; text-align: center; }
#messages { min-height: 1.7em; margin: 24px 0; overflow-wrap: anywhere; }
.transaction-page { max-width: 760px; padding: 40px 0 64px; text-align: center; }
.transaction-logo { width: 100px; height: auto; }
.transaction-page h3 { margin: 24px 0; font-size: 22px; line-height: 1.4; text-transform: uppercase; }
.transaction-page .small { font-size: 13px; }
.transaction-page #subscribe, .transaction-page #update_cc { padding-top: 28px; }

@media (max-width: 700px) {
  .page-container { width: calc(100% - 32px); }
  .nav-inner { flex-direction: column; gap: 8px; padding: 12px 0; }
  .nav-links { gap: 8px 16px; }
  .nav-links a { font-size: 10px; }
  .site-page [id] { scroll-margin-top: 150px; }
  .hero { padding: 32px 0 16px; }
  .site-page h1 { font-size: 38px; }
  .hero h1 { font-size: clamp(40px, 9vw, 54px); }
  .hero-description { font-size: 18px; }
  .hero-preview { margin-top: 24px; }
  .feature-copy h2, .pricing-section h2 { font-size: 30px; }
  .feature-section { padding: 28px 0; }
  .feature-layout { grid-template-columns: 1fr; gap: 24px; }
  .feature-preview { padding: 16px 12px; }
  .pricing-section { grid-template-columns: 1fr; gap: 24px; margin: 24px auto 32px; padding: 20px; }
  .project-info { grid-template-columns: 1fr; gap: 24px; padding-bottom: 32px; }
}

@media (prefers-reduced-motion: reduce) {
  .site-page .install-button { transition: none; }
  .site-page .install-button:hover { transform: none; }
}
